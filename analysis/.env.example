# Copy to analysis/.env and fill in the values you need.
#
# This file is loaded by: main.py, analysis/pdf_extractor.py,
# analysis/batch_extract.py, scripts/archive_to_r2.py, scripts/list_gemini_models.py
#
# Two variables below are NOT read from this file — see the notes on each.
# Everything is optional: with no keys at all you can still download PDFs
# (extraction is skipped) and scrape used cars / CPO listings.

# ── PDF extraction (analysis/pdf_extractor.py) ──────────────────────────────
# extract_pdf_with_fallback() tries these three providers in order and needs
# at least one to be set, otherwise it raises. main.py additionally gates
# auto-extraction on GEMINI_API_KEY specifically: if it is unset, the
# download run skips extraction entirely even if the other two keys are set.

# Primary extractor (Gemini vision, via the OpenAI-compatible endpoint).
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback 1: DeepSeek, text-only. Skipped for image-based/garbled PDFs.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Fallback 2: Xiaomi Mimo vision. Pages are rendered to images with PyMuPDF.
XIAOMI_API_KEY=your_xiaomi_api_key_here

# ── COE bidding results (scripts/download_coe.py) ───────────────────────────
# NOTE: download_coe.py loads the PROJECT ROOT .env, not this file. Put this
# one in ./.env (or export it) — setting it here has no effect.
# Optional: the data.gov.sg API works without a key, just with tighter rate
# limits. Sent as the `x-api-key` header.
# DATA_GOV_API_KEY=your_data_gov_sg_api_key_here

# ── Cloudflare R2 archival (scripts/archive_to_r2.py) ───────────────────────
# All four are required for a real upload. `--dry-run` needs none of them.
# R2_ACCOUNT_ID=your_r2_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name

# ── Used car scraper proxies (sgcarmart/core/used.py) ───────────────────────
# NOTE: nothing calls load_dotenv() before used.py reads these — they are read
# from os.environ at import time. They must be REAL environment variables
# (exported in your shell, or set by the workflow); setting them here has no
# effect. In CI, watch-used-cars.yml populates PROXY_FALLBACKS from
# proxyscrape.com.
# Optional: both scraping paths work without proxies and only fall back to
# them when a direct request is blocked.
#
# Single proxy, used by the Playwright path (passed as chromium's --proxy-server).
# export PROXY_SERVER=socks5://host:port
#
# Comma-separated rotation list, used by both the HTTP and Playwright paths.
# Capped at the first 10 entries to bound worst-case retry time.
# export PROXY_FALLBACKS=socks5://host1:port,http://host2:port
